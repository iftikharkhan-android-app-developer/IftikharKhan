<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/websiteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    tools:context=".WebsiteActivity">

    <!-- Header Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/websiteToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_light"
        android:paddingStart="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/spacing_small"
        app:navigationIcon="@drawable/baseline_arrow_back_ios_new_24"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/website_title"
        app:titleTextColor="@color/text_primary"
        app:subtitle="@string/website_subtitle"
        app:subtitleTextColor="@color/text_muted"
        app:elevation="0dp"/>

    <!-- Thin Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/webProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary_pink"
        android:progressBackgroundTint="@color/progress_bg"
        android:visibility="gone"/>

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:overScrollMode="never"/>

        <!-- Error State Screen -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_light"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_huge"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="82dp"
                android:layout_height="82dp"
                app:cardBackgroundColor="@color/primary_pink_light"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_wifi_off"
                    android:contentDescription="@null"
                    app:tint="@color/primary_pink" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/errorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxlarge"
                android:gravity="center"
                android:text="@string/error_website_unavailable"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_tiny"
                android:text="@string/error_check_connection"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_size_subhead"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_huge"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="140dp"
                    android:layout_height="@dimen/button_height_standard"
                    android:text="@string/btn_try_again"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_pink"
                    app:cornerRadius="@dimen/corner_radius_medium"
                    app:elevation="@dimen/card_elevation_low"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenExternal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:text="@string/open_in_browser"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_pink"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/corner_radius_medium"
                    app:strokeColor="@color/primary_pink"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Floating Bottom Browser Controls Dock -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomDockCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius_hero"
        app:cardElevation="@dimen/card_elevation_high"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="@dimen/stroke_width_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingVertical="@dimen/spacing_small">

            <!-- Back Action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnWebBack"
                android:layout_width="0dp"
                android:layout_height="@dimen/dock_item_height"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/bg_light"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="@color/primary_pink_ripple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icWebBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_web_back"
                        android:contentDescription="@string/btn_back"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtWebBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/btn_back"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Forward Action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnWebForward"
                android:layout_width="0dp"
                android:layout_height="@dimen/dock_item_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/bg_light"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="@color/primary_pink_ripple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icWebForward"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_web_forward"
                        android:contentDescription="@string/btn_forward"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtWebForward"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/btn_forward"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Refresh Action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnWebRefresh"
                android:layout_width="0dp"
                android:layout_height="@dimen/dock_item_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/primary_pink_light"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_pink_stroke"
                app:strokeWidth="@dimen/stroke_width_thin"
                app:rippleColor="@color/primary_pink_ripple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icWebRefresh"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_web_refresh"
                        android:contentDescription="@string/btn_refresh"
                        app:tint="@color/primary_pink" />

                    <TextView
                        android:id="@+id/txtWebRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/btn_refresh"
                        android:textColor="@color/primary_pink"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Share Action -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnWebShare"
                android:layout_width="0dp"
                android:layout_height="@dimen/dock_item_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/bg_light"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:rippleColor="@color/primary_pink_ripple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icWebShare"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_web_share"
                        android:contentDescription="@string/btn_share"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtWebShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/btn_share"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
