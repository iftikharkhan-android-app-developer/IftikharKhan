<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    tools:context=".SplashActivity">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xxlarge">

        <!-- Main App Logo Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mtrlCardId"
            android:layout_width="@dimen/avatar_splash_main_size"
            android:layout_height="@dimen/avatar_splash_main_size"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/corner_radius_hero"
            app:cardElevation="@dimen/card_elevation_splash"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="@dimen/stroke_width_thin">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_image_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/my_pic" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Horizontal Animated Avatar -->
        <ImageView
            android:id="@+id/imageSle"
            android:layout_width="@dimen/avatar_splash_sle_size"
            android:layout_height="@dimen/avatar_splash_sle_size"
            android:layout_marginTop="@dimen/spacing_xxlarge"
            android:contentDescription="@string/profile_image_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_avatar" />

        <!-- Animated App Title -->
        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_splash_title"
            android:textStyle="bold" />

        <!-- Loading Subtitle -->
        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:text="@string/splash_loading"
            android:textColor="@color/splash_subtext"
            android:textSize="@dimen/text_size_body" />

        <!-- Loading Progress Bar Container -->
        <FrameLayout
            android:id="@+id/loadingTrack"
            android:layout_width="@dimen/loading_bar_width"
            android:layout_height="@dimen/loading_bar_height"
            android:layout_marginTop="@dimen/spacing_huge"
            android:background="@color/splash_divider"
            android:clipToOutline="true">

            <View
                android:id="@+id/loadingBar"
                android:layout_width="@dimen/loading_thumb_width"
                android:layout_height="match_parent"
                android:background="@color/primary_pink" />

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
