<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.IftikharKhan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_pink</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.IftikharKhan" parent="Base.Theme.IftikharKhan" />

    <!-- Android 12+ System Splash Screen Theme -->
    <style name="Theme.IftikharKhan.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.IftikharKhan</item>
    </style>
</resources>
